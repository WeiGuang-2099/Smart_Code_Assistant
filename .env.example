# Database Configuration
DATABASE_URL=mysql+aiomysql://appuser:apppassword@localhost:3307/smart_code_assistant
DB_HOST=localhost
DB_PORT=3307
DB_USER=appuser
DB_PASSWORD=apppassword
DB_NAME=smart_code_assistant

# FastAPI Configuration
FASTAPI_ENV=development
FASTAPI_PORT=8000
FASTAPI_HOST=0.0.0.0
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Frontend Configuration
VITE_API_URL=http://localhost:8000

# ----------------------------------------------------------------------------
# AI / LLM Configuration
# NOTE: the backend reads backend-fastapi/.env (not this root file). Copy these
# entries there. This file documents the available variables.
# ----------------------------------------------------------------------------
# Chat provider: "zhipuai" (default) or "openai". Empty model/base_url fields
# resolve to per-provider presets (see backend-fastapi/app/core/llm_config.py).
LLM_PROVIDER=zhipuai
# Primary API key. Falls back to ZHIPUAI_API_KEY when empty (backward compat).
# For OpenAI: set LLM_PROVIDER=openai and LLM_API_KEY=sk-...
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_MODEL_FAST=
LLM_MODEL_QUALITY=
LLM_MODEL_LIGHT=
# ZhipuAI key (used when LLM_PROVIDER=zhipuai and LLM_API_KEY is empty).
ZHIPUAI_API_KEY=

# Code knowledge graph embeddings.
# Provider: "sentence_transformers" (default, local model) or "openai".
# OpenAI embeddings reuse LLM_API_KEY / LLM_BASE_URL above.
# WARNING: switching providers changes vector dimensions - existing project
# collections must be re-indexed after a change.
CODE_GRAPH_EMBEDDING_PROVIDER=sentence_transformers
CODE_GRAPH_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Default project id for the MCP tools / semantic search. The corpus must be
# indexed under this id; use the list_projects MCP tool to discover valid ids.
CODE_GRAPH_DEFAULT_PROJECT_ID=1

# Load the local embedding model from cache only (no HuggingFace Hub network).
# Set true once the model is cached to eliminate per-startup HF requests, which
# can otherwise stall MCP server startup for minutes when the Hub is slow.
CODE_GRAPH_EMBEDDING_OFFLINE=false

# PDF-to-Markdown conversion (Datalab Marker API)
DATALAB_API_KEY=

# Sentry (optional - leave blank to disable)
# Backend
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_PROFILES_SAMPLE_RATE=0.0
SENTRY_RELEASE=
# Frontend (must be prefixed with VITE_ to be exposed to the browser bundle)
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_TRACES_SAMPLE_RATE=0.0
VITE_SENTRY_REPLAYS_SAMPLE_RATE=0.0
VITE_SENTRY_RELEASE=
